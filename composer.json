{
    "name": "xboard/xboard",
    "type": "project",
    "description": "xboard is a proxy protocol manage.",
    "keywords": [
        "xboard",
        "v2ray",
        "shadowsocks",
        "trojan",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "cedar2025/http-foundation": "6.4.x-dev",
        "cweagans/composer-patches": "^1.7",
        "doctrine/dbal": "^3.10",
        "firebase/php-jwt": "^7.0",
        "google/cloud-storage": "^1.51",
        "google/recaptcha": "^1.3",
        "guzzlehttp/guzzle": "^7.10",
        "hhxsv5/laravel-s": "~3.7.0",
        "joanhey/adapterman": "^0.7.1",
        "laravel/framework": "^10.50.2",
        "laravel/horizon": "^5.47",
        "laravel/tinker": "^2.11",
        "linfo/linfo": "^4.0.9",
        "paragonie/sodium_compat": "^1.24",
        "php-curl-class/php-curl-class": "^8.10",
        "spatie/db-dumper": "^3.8",
        "stripe/stripe-php": "^20.1",
        "symfony/http-client": "^6.4",
        "symfony/mailgun-mailer": "^6.4",
        "symfony/yaml": "^6.4",
        "workerman/workerman": "^5.2",
        "zoujingli/ip2region": "^2.0.8"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.16",
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^7.12",
        "orangehill/iseed": "^3.8",
        "phpunit/phpunit": "^10.5",
        "spatie/laravel-ignition": "^2.9"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "cweagans/composer-patches": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "patches": {
            "joanhey/adapterman": {
                "http": "patches/Http.patch"
            }
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Library\\": "library/"
        },
        "classmap": [
            "database/seeders",
            "database/factories"
        ],
        "files": [
            "app/Helpers/Functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packagist.org"
        }
    ]
}
